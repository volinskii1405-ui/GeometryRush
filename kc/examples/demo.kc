// demo.kc — пример программы на kc
int counter = 0;

int fib(int n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

int main() {
    println("Hello from kc!");

    // рекурсия + цикл for
    for (int i = 0; i < 10; i++) {
        print_int(fib(i));
        putchar(' ');
    }
    putchar('\n');

    // «массив» в памяти (mmap) и индексация a[i] (элемент = 8 байт)
    int arr = alloc(8 * 5);
    for (int i = 0; i < 5; i++) {
        arr[i] = i * i;
        counter += arr[i];
    }
    print("sum of squares = ");
    print_int(counter);
    putchar('\n');

    // указатели
    int p = &counter;
    *p = *p + 100;
    print_int(counter);
    putchar('\n');

    // побайтовый доступ к строке
    int s = "abc";
    store8(s, 'X');
    println(s);

    return 0; // код возврата процесса
}
